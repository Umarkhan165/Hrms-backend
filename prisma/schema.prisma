// Enterprise HRMS - Prisma schema
// Simplified relative to the full SRS (no separate ROLES/PERMISSIONS tables -
// role is an enum on User, which is enough for 4 fixed roles) but every
// module/workflow/field group from the blueprint is represented.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Auth / RBAC
enum Role {
  EMPLOYEE
  MANAGER
  HR
  ADMIN
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?
  fullName     String
  role         Role      @default(EMPLOYEE)
  isVerified   Boolean   @default(false)
  isActive     Boolean   @default(true)
  lastLogin    DateTime?

  // onboarding / account activation
  activationToken       String?   @unique
  activationTokenExpiry DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  employee           Employee?
  sessions           Session[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  managedDepartments Department[]   @relation("DepartmentManager")
  ledTeams           Team[]         @relation("TeamLead")

  @@index([deletedAt])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String
  ipAddress    String?
  deviceInfo   String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

// Organizational structure
model Department {
  id        String     @id @default(uuid())
  name      String
  managerId String?
  manager   User?      @relation("DepartmentManager", fields: [managerId], references: [id])
  teams     Team[]
  employees Employee[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
}

model Team {
  id           String     @id @default(uuid())
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  leadId       String?
  lead         User?      @relation("TeamLead", fields: [leadId], references: [id])
  employees    Employee[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERN
  CONTRACTOR
}

enum EmployeeStatus {
  ACTIVE
  TERMINATED
  ON_LEAVE
  PENDING
}

model Employee {
  id             String         @id @default(uuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode   String         @unique
  departmentId   String?
  department     Department?    @relation(fields: [departmentId], references: [id])
  teamId         String?
  team           Team?          @relation(fields: [teamId], references: [id])
  managerId      String?
  manager        Employee?      @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports  Employee[]     @relation("EmployeeManager")
  designation    String
  employmentType EmploymentType @default(FULL_TIME)
  salary         Decimal?       @db.Decimal(12, 2)
  joiningDate    DateTime
  status         EmployeeStatus @default(PENDING)

  documents     EmployeeDocument[]
  attendances   Attendance[]
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  goalsOwned    Goal[]             @relation("GoalEmployee")
  goalsCreated  Goal[]             @relation("GoalCreator")
  reviews       Review[]           @relation("ReviewEmployee")
  reviewsGiven  Review[]           @relation("ReviewReviewer")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model EmployeeDocument {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  docType    String
  fileUrl    String
  uploadedAt DateTime @default(now())
}

// Attendance
enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
}

model Attendance {
  id             String            @id @default(uuid())
  employeeId     String
  employee       Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceDate DateTime          @db.Date
  clockIn        DateTime?
  clockOut       DateTime?
  status         AttendanceStatus  @default(PRESENT)
  totalHours     Decimal?          @db.Decimal(5, 2)
  breaks         AttendanceBreak[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([employeeId, attendanceDate])
}

model AttendanceBreak {
  id              String     @id @default(uuid())
  attendanceId    String
  attendance      Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  startTime       DateTime
  endTime         DateTime?
  durationMinutes Int?
}

// Leave
enum LeaveRequestStatus {
  PENDING
  APPROVED_MANAGER
  APPROVED_HR
  REJECTED
}

model LeaveType {
  id                String         @id @default(uuid())
  name              String         @unique
  defaultAllocation Int            @default(0)
  balances          LeaveBalance[]
  requests          LeaveRequest[]
}

model LeaveBalance {
  id            String    @id @default(uuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId   String
  leaveType     LeaveType @relation(fields: [leaveTypeId], references: [id])
  remainingDays Int

  @@unique([employeeId, leaveTypeId])
}

model LeaveRequest {
  id             String             @id @default(uuid())
  employeeId     String
  employee       Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId    String
  leaveType      LeaveType          @relation(fields: [leaveTypeId], references: [id])
  startDate      DateTime           @db.Date
  endDate        DateTime           @db.Date
  days           Int
  reason         String
  status         LeaveRequestStatus @default(PENDING)
  managerComment String?
  hrComment      String?
  requestedAt    DateTime           @default(now())
  decidedAt      DateTime?
}

// Goals
enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  ACHIEVED
  DEFERRED
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
}

model Goal {
  id          String       @id @default(uuid())
  employeeId  String
  employee    Employee     @relation("GoalEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   Employee     @relation("GoalCreator", fields: [createdById], references: [id])
  title       String
  description String?
  targetDate  DateTime     @db.Date
  priority    GoalPriority @default(MEDIUM)
  status      GoalStatus   @default(NOT_STARTED)
  progress    Int          @default(0)
  validatedAt DateTime?
  updates     GoalUpdate[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model GoalUpdate {
  id        String   @id @default(uuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  progress  Int
  comment   String
  createdAt DateTime @default(now())
}

// Performance reviews (360)
model ReviewCycle {
  id        String           @id @default(uuid())
  name      String
  startDate DateTime         @db.Date
  endDate   DateTime         @db.Date
  active    Boolean          @default(true)
  templates ReviewTemplate[]
  reviews   Review[]
  createdAt DateTime         @default(now())
}

model ReviewTemplate {
  id        String           @id @default(uuid())
  cycleId   String
  cycle     ReviewCycle      @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  name      String
  questions ReviewQuestion[]
  reviews   Review[]
}

model ReviewQuestion {
  id         String         @id @default(uuid())
  templateId String
  template   ReviewTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  category   String
  text       String
  weight     Decimal        @default(1) @db.Decimal(4, 2)
  answers    ReviewAnswer[]
}

enum ReviewType {
  SELF
  PEER
  MANAGER
}

enum ReviewStatus {
  PENDING
  SUBMITTED
  PUBLISHED
  ACKNOWLEDGED
}

model Review {
  id             String         @id @default(uuid())
  cycleId        String
  cycle          ReviewCycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  templateId     String
  template       ReviewTemplate @relation(fields: [templateId], references: [id])
  employeeId     String
  employee       Employee       @relation("ReviewEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId     String?
  reviewer       Employee?      @relation("ReviewReviewer", fields: [reviewerId], references: [id])
  reviewType     ReviewType
  status         ReviewStatus   @default(PENDING)
  overallScore   Decimal?       @db.Decimal(5, 2)
  comments       String?
  submittedAt    DateTime?
  acknowledgedAt DateTime?
  answers        ReviewAnswer[]
  createdAt      DateTime       @default(now())
}

model ReviewAnswer {
  id         String         @id @default(uuid())
  reviewId   String
  review     Review         @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  questionId String
  question   ReviewQuestion @relation(fields: [questionId], references: [id])
  rating     Int
  comment    String?
}

// Notifications & Audit
enum NotificationType {
  LEAVE_APPROVED
  LEAVE_REQUEST
  LEAVE_REJECTED
  GOAL_ASSIGNED
  GOAL_VALIDATION
  REVIEW_DUE
  GENERAL
  BROADCAST
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(GENERAL)
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  module    String
  oldData   Json?
  newData   Json?
  createdAt DateTime @default(now())
}

model RbacRole {
  id          String               @id @default(uuid())
  name        String               @unique
  description String?
  permissions RbacRolePermission[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model Permission {
  id        String               @id @default(uuid())
  name      String               @unique // e.g. 'leave:approve'
  module    String // e.g. 'Leave'
  action    String // 'CREATE' | 'READ' | 'UPDATE' | 'DELETE'
  roles     RbacRolePermission[]
  createdAt DateTime             @default(now())
}

model RbacRolePermission {
  roleId       String
  permissionId String
  role         RbacRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedAt   DateTime   @default(now())

  @@id([roleId, permissionId])
}

model Broadcast {
  id             String   @id @default(uuid())
  title          String
  message        String
  targetRole     String? // null = all staff, otherwise EMPLOYEE/MANAGER/HR/ADMIN
  recipientCount Int
  sentById       String // plain scalar, intentionally not a relation
  createdAt      DateTime @default(now())
}
